<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Release/App Store builds attest against Apple's production environment.
	     AppAttestManager uses DCAppAttestService; without this entitlement the
	     service reports featureUnsupported on device and every proxied request
	     ships without a valid assertion. -->
	<key>com.apple.developer.devicecheck.appattest-environment</key>
	<string>production</string>
</dict>
</plist>
